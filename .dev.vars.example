# Copy this file to .dev.vars and fill in your own values. The Worker reads it during local development (npm run dev).
# .dev.vars must never be committed (.gitignore already excludes it).
# Production doesn't use this file; use: npx wrangler secret put <NAME>

OSU_CLIENT_ID=your_client_id_here
OSU_CLIENT_SECRET=your_client_secret_here

# Key for signing round tokens and login cookies. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different, fresh value in production; don't share it with your local setup.
ROUND_TOKEN_SECRET=change_this_to_a_long_random_string

# Local development only: the client runs on Vite (5173) and the API on wrangler (3000), so the login URLs
# must be set explicitly. This redirect URI must be registered in your osu! OAuth application's Callback URLs.
# Don't set these two in production (the Worker uses the site's own origin automatically).
OSU_REDIRECT_URI=http://localhost:3000/api/auth/callback
FRONTEND_URL=http://localhost:5173
