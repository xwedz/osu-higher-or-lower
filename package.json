{
  "name": "osu-higherlower",
  "version": "0.1.0",
  "description": "osu! 玩家數值 Higher or Lower 猜謎遊戲（Cloudflare Workers + D1）",
  "main": "src/index.js",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply osu-higher-lower --local",
    "db:migrate:remote": "wrangler d1 migrations apply osu-higher-lower --remote",
    "fetch:players": "node scripts/fetchTopPlayers.js",
    "fetch:famous": "node scripts/fetchFamousPlayers.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
