# Copy this file to .env and fill in your own values.
# .env is only used by the fetch scripts (scripts/); the Worker reads .dev.vars locally and Cloudflare secrets in production.
# .env must never be committed to GitHub (.gitignore already excludes it).

# Create an OAuth application in the OAuth section of your osu! account settings:
#   https://osu.ppy.sh/home/account/edit
OSU_CLIENT_ID=your_client_id_here
OSU_CLIENT_SECRET=your_client_secret_here
