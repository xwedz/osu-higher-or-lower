# 複製這個檔案為 .env，並填入你自己的值。
# .env 本身不應該被提交到 GitHub（.gitignore 已經排除它了）。

# SQLite 資料庫檔案的位置，維持這個值就好，Prisma 會自動在這裡建立檔案。
DATABASE_URL="file:./dev.db"

# 到 osu! 的 OAuth 應用程式設定頁面申請取得，跟 osu! Better Profile
# 那個專案是完全獨立的兩組憑證，不要共用同一組。
OSU_CLIENT_ID=your_client_id_here
OSU_CLIENT_SECRET=your_client_secret_here

#Secret for roundToken.
#Insert random string.
ROUND_TOKEN_SECRET=change_this_to_a_long_random_string

# osu! 登入用。Redirect URI 必須跟 osu! OAuth 應用程式設定裡登記的完全一致。
# 下面兩個是本機開發的預設值，沒設定的話程式會自動使用；部署到正式網址時再改。
# OSU_REDIRECT_URI=http://localhost:3000/api/auth/callback
# FRONTEND_URL=http://localhost:5173
