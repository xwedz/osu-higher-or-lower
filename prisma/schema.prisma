// Prisma schema — 定義資料庫長什麼樣子，Prisma 會依照這份檔案
// 自動生成對應的資料庫操作函式，不需要自己手寫 SQL。

datasource db {
  // 目前先用 SQLite（整個資料庫就是一個檔案），之後如果要換成
  // PostgreSQL 或 MySQL，通常只需要改這裡的 provider 跟 url，
  // 底下的 model 定義幾乎不用動。
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// 玩家候選池 —— 定期從 osu! API 抓下來、快取在本地的玩家資料。
/// 遊戲每一輪都是從這張表裡隨機挑兩位玩家出來比較。
model Player {
  id          Int      @id @default(autoincrement())

  /// osu! 官方的使用者 id，用來避免重複抓同一位玩家、
  /// 之後也可以拿這個 id 去組出玩家個人頁面的連結。
  osuUserId   Int      @unique

  username    String

  /// 這幾個就是遊戲裡實際會拿來互相比較的數值，
  /// 對應到我們規劃的三種模式：遊玩次數、準確率、總遊玩時數。
  /// 三個欄位都直接來自 /rankings 這支端點單次回傳的資料，
  /// 不需要對每位玩家再額外查詢。
  playCount   Int
  accuracy    Float
  playtime    Int      // 單位是秒

  /// 下面這些是顯示在玩家卡上的「參考資訊」，讓不熟悉的玩家也能有個概念。
  /// 全部可為空：知名玩家可能是停止活動的帳號，抓不到排名。
  countryCode String?
  countryName String?
  globalRank  Int?
  pp          Float?

  /// 手動維護的一句話說明（例如 "World Cup champion"），只有知名玩家會有。
  note        String?

  /// 標記這筆資料是排行榜自動抓的，還是你自己手動加進去的
  /// 「社群知名玩家」名單，方便之後想單獨管理這批特殊名單。
  isSpecial   Boolean  @default(false)

  /// 每次重新從 osu! API 同步資料時更新，方便你之後排查
  /// 「這筆資料是不是太舊了」這類問題。
  updatedAt   DateTime @updatedAt
}

/// 排行榜 —— 每位登入的玩家、每個「模式 × 玩家池」只保留最高的一筆連勝。
/// 只有用 osu! 帳號登入後開始的遊戲才會被記錄。
model LeaderboardEntry {
  id          Int      @id @default(autoincrement())

  osuUserId   Int

  /// 名字、國家是「最近一次刷新紀錄時」的快照，玩家改名後下次破紀錄就會更新。
  username    String
  countryCode String?
  countryName String?

  /// 對應遊戲的三種模式："playCount" / "accuracy" / "playtime"。
  mode        String

  /// 玩家池："famous" / "top100" / "top1000"。不同難度的連勝不能混在一起比。
  pool        String

  streak      Int

  /// 達成這個連勝的時間；同分時，先達成的排在前面。
  achievedAt  DateTime @default(now())

  @@unique([osuUserId, mode, pool])
  @@index([mode, pool, streak])
}
