{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "osu-higher-lower",
    "main": "src/index.js",
    "compatibility_date": "2026-09-01",
    // node:crypto (HMAC signing) needs this flag
    "compatibility_flags": ["nodejs_compat"],

    // The production domain. The old workers.dev URL must stay enabled so old links (such as the Reddit post)
    // can be redirected; with routes set, workers_dev may be inferred as false, so it is set explicitly.
    "routes": [{ "pattern": "osuhigherlower.xwedz.dev", "custom_domain": true }],
    "workers_dev": true,

    // Where workers.dev pages redirect to. If you fork this project, change it to your own URL, or remove it to disable the redirect.
    "vars": { "CANONICAL_ORIGIN": "https://osuhigherlower.xwedz.dev" },

    // The client (client/dist). Every request goes through the Worker first so the old URL's home page can be
    // redirected; the cost is that static file requests also count toward the Worker's daily quota.
    // Paths with no matching file return index.html (single-page application).
    "assets": {
        "directory": "./client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "osu-higher-lower",
            // After running `npx wrangler d1 create osu-higher-lower`, put the printed database_id here.
            // Local development (--local) doesn't use this value, so a placeholder works there.
            "database_id": "b81e2b6c-9f0b-46ca-8abf-159e11103f41",
            "migrations_dir": "migrations"
        }
    ],

    // Per-IP rate limit (Workers Rate Limiting binding).
    // A normal player makes a few dozen requests a minute at most, so 100 is generous. The limit is loose and
    // counted per data center: it stops one source from hammering the API, but it isn't an exact total.
    // period can only be 10 or 60 seconds.
    "ratelimits": [
        {
            "name": "API_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ],

    // Delete expired UsedToken rows once a day
    "triggers": { "crons": ["17 4 * * *"] }

    // Never put secrets (OSU_CLIENT_ID, OSU_CLIENT_SECRET, ROUND_TOKEN_SECRET) here:
    //   local:      put them in .dev.vars (already in .gitignore)
    //   production: npx wrangler secret put OSU_CLIENT_ID  (same for the other two)
}
